  "version": "2.0.0",
  "options": {
    "env": {
      "PATH": "/home/xander/.bun/bin:/home/xander/.bun/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin:/home/xander/.dotnet/tools:/home/xander/.cargo/bin/:/home/xander/.spicetify:/home/xander/.cargo/bin/:/home/xander/.spicetify:/home/xander/.cargo/bin/:/home/xander/.spicetify"
    }
  },
  "tasks": [
    {
      "label": "bun: start",
      "type": "shell",
      "command": "bun run start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "(.*?)"
          },
          "endsPattern": {
            "regexp": "bundle generation complete"
          }
        }
      }
    },
    {
      "label": "bun: test",
      "type": "shell",
      "command": "bun run test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "(.*?)"
          },
          "endsPattern": {
            "regexp": "bundle generation complete"
          }
        }
      }
    }
  ]
}
